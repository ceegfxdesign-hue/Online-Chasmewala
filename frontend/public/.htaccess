# Serve the React application for client-side routes on Apache/LiteSpeed (Hostinger).
# Real files/folders and API routes are served normally; non-existent static assets return 404.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do NOT rewrite API routes to index.html (pass through to backend handler)
  RewriteRule ^api(/.*)?$ - [L]

  # Block access to hidden files/directories (dotfiles) except .well-known
  RewriteRule "(^|/)\.(?!well-known)" - [F]

  # Real files and directories are served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If a missing static file/asset with an extension is requested, return 404 (do NOT serve SPA HTML)
  RewriteCond %{REQUEST_URI} \.(?:zip|tar|gz|tgz|rar|7z|json|xml|txt|pdf|csv|sql|bak|old|swp|env|config|ini|log|map|js|css|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot)$ [NC]
  RewriteRule ^ - [R=404,L]

  # Only rewrite extensionless routes to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # ── Security Response Headers ───────────────────────────────────────────────
  # Enforce HTTPS HSTS (confirmed https://onlinechasmewala.com loads over HTTPS)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Frame protection / anti-clickjacking
  Header always set X-Frame-Options "DENY"
  # Referrer leak protection
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Restrict browser feature access (allow payment for checkout gateway)
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=*"
  # Restrictive Content Security Policy compatible with Google Fonts, image CDNs, and Razorpay
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://images.unsplash.com https://res.cloudinary.com https://cdn.corenexis.com https://cdn.imageurlgenerator.com https://*.razorpay.com; media-src 'self' data: blob:; connect-src 'self' https://onlinechasmewala.com https://api.razorpay.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'self' https://api.razorpay.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;"

  # Ensure index.html is never cached so new builds load immediately
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>


